<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kmpc_cpp</name>
  <version>0.1.0</version>
  <description>C++ whole-body kinematic MPC. Algebra matches whole_body_kmpc (09-04).</description>
  <maintainer email="davy@todo.todo">davy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <!-- Required when KMPC_BUILD_ROS2=ON (kmpc_node). Offline -DKMPC_BUILD_ROS2=OFF skips find_package. -->
  <depend>kmpc_msgs</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>pinocchio</depend>
  <depend>proxsuite</depend>

  <exec_depend>xoip_ros2</exec_depend>
  <exec_depend>whole_body_kmpc</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
