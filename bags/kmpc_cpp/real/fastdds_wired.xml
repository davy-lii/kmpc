<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_wired_only</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList>
                <address>192.168.4.2</address>
            </interfaceWhiteList>
            <sendBufferSize>8388608</sendBufferSize>
            <receiveBufferSize>8388608</receiveBufferSize>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="wired_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_wired_only</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
